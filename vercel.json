{
  "functions": {
    "api/send-report.ts": {
      "includeFiles": "data/*.json"
    },
    "api/[...path].ts": {
      "includeFiles": "data/*.json"
    }
  },
  "rewrites": [
    {
      "source": "/api/((?!send-report).*)",
      "destination": "/api/[...path]"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
 "crons": [
    {
      "path": "/api/send-report",
      "schedule": "31 7 * * *"
    }
  ]
}